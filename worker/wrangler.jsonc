{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subscription-tracker-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "FRONTEND_URL": "http://localhost:3000",
    "ENVIRONMENT": "development"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "subscription-tracker-db",
      "database_id": "subscription-tracker-db-local",
      "migrations_dir": "migrations",
      "preview_database_id": "subscription-tracker-db-local"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "subscription-tracker-storage"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "local-cache-id-placeholder",
      "preview_id": "local-cache-id-placeholder"
    }
  ]
}
