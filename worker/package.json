{
  "name": "subscription-tracker-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --persist-to=.wrangler/state",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "migrate:local": "wrangler d1 execute subscription-tracker-db --local --file=./migrations/0001_initial.sql",
    "migrate:remote": "wrangler d1 execute subscription-tracker-db --remote --file=./migrations/0001_initial.sql"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "hono": "^4.7.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@types/bcryptjs": "^2.4.6",
    "typescript": "^5.7.3",
    "wrangler": "^3.108.0"
  }
}
